# RDT&E only: source-only Go build and isolated FFmpeg runtime.
# Exact tags are experiment inputs; base-image digests and package repository
# snapshots remain production-promotion gates until independently locked.
FROM golang:1.23.12-alpine3.21 AS builder
WORKDIR /src
ENV GOPROXY=off GOSUMDB=off GOWORK=off GOTOOLCHAIN=local CGO_ENABLED=0
COPY go.mod ./
COPY cmd/ ./cmd/
RUN go build -trimpath -ldflags="-s -w" -o /bin/bakeoff ./cmd/bakeoff

FROM alpine:3.21.6
RUN apk add --no-cache ffmpeg
COPY --from=builder /bin/bakeoff /usr/local/bin/bakeoff
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bakeoff"]

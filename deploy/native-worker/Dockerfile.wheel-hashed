# Research candidate: hashed original CPython wheels, unqualified Debian apt dependencies.
# No source/model bytes or private character content in the public image.
FROM python:3.11-slim-bookworm@sha256:94a8fee35252d06ab75856f15f12c7bae67b10e8a6da93c7fded82b2610926cd
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp XDG_CONFIG_HOME=/tmp/config XDG_CACHE_HOME=/tmp/cache \
    LIBGL_ALWAYS_SOFTWARE=1 OMP_NUM_THREADS=2
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ffmpeg xvfb xauth libegl1 libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
      libxi6 libxkbcommon0 libxfixes3 libxxf86vm1 libasound2 libfontconfig1 \
      libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# BuildKit bind mounts do not add the 401 MB wheelhouse into final image layers.
# This step explicitly disables the network; all original bytes come from exact SHA-checked wheels.
RUN --network=none \
    --mount=type=bind,source=wheelhouse,target=/wheelhouse,readonly \
    --mount=type=bind,source=requirements-hashed.txt,target=/requirements.txt,readonly \
    python -m pip install --no-index --require-hashes --only-binary=:all: \
      --force-reinstall --find-links=/wheelhouse -r /requirements.txt && \
    python -m pip check
WORKDIR /src
USER 65532:65532
ENTRYPOINT ["python"]
CMD ["-c","import bpy; assert bpy.app.version[:2] == (4,5); print('HASHED_NATIVE_BPY', bpy.app.version_string)"]
